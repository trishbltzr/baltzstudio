{
  "name": "baltazar-studio-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "eval:agent": "NODE_OPTIONS=--conditions=react-server tsx scripts/eval-governed-agent.ts",
    "smoke:agent": "NODE_OPTIONS=--conditions=react-server tsx scripts/smoke-governed-agent.ts",
    "smoke:engines": "node scripts/smoke-portal-engines.mjs",
    "smoke:mobile": "node scripts/smoke-portal-mobile.mjs",
    "verify:supabase-hardening": "node scripts/verify-legacy-portal-hardening.mjs",
    "test:notifications": "tsx scripts/test-portal-notifications.ts",
    "test:workflow": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-service-workflow.ts",
    "test:shadow": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-shadow-projection.ts"
  },
  "dependencies": {
    "@openai/agents": "^0.13.5",
    "@sparticuz/chromium": "^138.0.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/sandbox": "2.8.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.0",
    "lucide-react": "^0.475.0",
    "next": "16.2.11",
    "nodemailer": "^9.0.3",
    "puppeteer-core": "^25.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "0.35.0",
    "workflow": "4.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "~5.7.2"
  },
  "overrides": {
    "postcss": "8.5.15",
    "sharp": "0.35.0"
  }
}
