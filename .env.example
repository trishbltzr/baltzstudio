NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_WEB-AUDIT_API_KEY=
OPENAI_BRAND-AUDIT_API_KEY=
OPENAI_SEO-AUDIT_API_KEY=
OPENAI_WEB-BUILDER_API_KEY=
OPENAI_FUNNEL-BUILDER_API_KEY=
OPENAI_SOCIAL-MEDIA-BUILDER_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_GA4_CLIENT_ID=
GOOGLE_GA4_CLIENT_SECRET=
GOOGLE_GA4_OAUTH_STATE_SECRET=
GOOGLE_GA4_REDIRECT_URI=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_CHAT_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6

# Local/self-hosted Workflow development only. Vercel production uses the
# managed Workflow runtime rather than this in-process queue.
WORKFLOW_LOCAL_QUEUE_CONCURRENCY=1

# Transactional SMTP is server-only and remains separate from Hostinger
# marketing lists. Use the full mailbox address as SMTP_USER.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Baltazar Studio Portal <portal@baltz.studio>"
PORTAL_ADMIN_EMAIL=portal@baltz.studio
